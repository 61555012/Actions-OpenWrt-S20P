# 直接合并进固件根目录的文件，必须原样保持 LF：
# ucode 脚本与 LuCI 前端不带 CRLF，避免在 Windows 上编辑后被 autocrlf 改写。
files/usr/share/rpcd/ucode/luci text eol=lf
files/www/luci-static/resources/view/status/include/10_system.js text eol=lf

# 开机脚本 / 首启脚本 / lua 插件同理：
# CRLF 的 /etc/init.d/* 在 busybox ash 下会报 "not found"（\r 成了命令名的一部分），
# 采样器永远起不来；lua 与 .htm 虽然能容忍 CRLF，也一并对齐成 LF。
files/etc/init.d/* text eol=lf
files/etc/uci-defaults/* text eol=lf
files/usr/lib/lua/luci/controller/oaf_status_users.lua text eol=lf
files/usr/lib/lua/luci/view/oaf_status/*.htm text eol=lf
files/usr/lib/lua/luci/model/cbi/oaf_status/*.lua text eol=lf
files/usr/lib/lua/luci/oaf_traffic.lua text eol=lf
files/usr/lib/lua/luci/oaf_app_names.lua text eol=lf

# 二进制文件不做任何换行/文本转换
*.png binary
*.bin binary
*.itb binary
